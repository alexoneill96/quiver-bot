# QuiverQuant Signal Filter & Alert Service
# Copy this file to .env and fill in your values

# =============================================================================
# SERVER
# =============================================================================
PORT=3000

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
DB_HOST=localhost
DB_PORT=5433
DB_USER=quiverbot
DB_PASSWORD=quiverbot
DB_NAME=quiverbot

# =============================================================================
# TWITTER / X API
# =============================================================================
# Provider: 'x' (official Twitter API) or 'rapidapi'
TWITTER_PROVIDER=rapidapi
TWITTER_TARGET_USERNAME=QuiverQuant
TWITTER_USE_MOCK=false

# Official X API (when TWITTER_PROVIDER=x)
TWITTER_BEARER_TOKEN=

# RapidAPI (when TWITTER_PROVIDER=rapidapi)
RAPIDAPI_KEY=
QUIVERQUANT_REST_ID=1074457475485712384

# =============================================================================
# LLM PROVIDER
# =============================================================================
LLM_PROVIDER=openai
LLM_USE_MOCK=false

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_PROMPT_VERSION=V2

# Anthropic (alternative)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307

# =============================================================================
# EMAIL (Sender.net)
# =============================================================================
SENDER_API_KEY=
SENDER_FROM_EMAIL=
SENDER_FROM_NAME=QuiverQuant Alerts
EMAIL_TEST_MODE=false

# =============================================================================
# NOTIFICATION CHANNELS
# =============================================================================
EMAIL_ALERTS=true
TELEGRAM_ALERTS=false

# Telegram Bot (create via @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_DISABLE_PREVIEW=true

# =============================================================================
# SIGNAL PROCESSING
# =============================================================================
SIGNAL_THRESHOLD=0.5
ALERT_THRESHOLD=0.7
CLASSIFICATION_BATCH_SIZE=10

# =============================================================================
# FEATURE FLAGS
# =============================================================================
INGESTION_ENABLED=true
CLASSIFICATION_ENABLED=true
ALERTING_ENABLED=true
SUMMARY_ENABLED=true

# =============================================================================
# SCHEDULING
# =============================================================================
# Spring cron format: seconds minutes hours day-of-month month day-of-week
SUMMARY_CRON=0 0 13 * * *
DISABLE_CRON_JOBS=false
